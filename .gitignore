# pyenv
#   For a library or package, you might want to ignore these files since the author may
#   choose a specific version for their development environment.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in cases where the author prefers not to, uncomment the next line:
# Pipfile.lock

# poetry
#   Poetry uses poetry.lock to ensure reproducible builds.
#   You should generally commit poetry.lock unless you have a specific reason not to.
# poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm-python.json
.pdm-python.json
.pdm-build/

